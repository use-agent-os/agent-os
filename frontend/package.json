{
  "name": "agentos-control-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React control console for AgentOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run bundle:budget",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "check": "tsc --noEmit && eslint src && prettier --check src && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "motion": "^12.42.2",
    "qrcode-generator": "^1.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^27.0.1",
    "playwright": "1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
